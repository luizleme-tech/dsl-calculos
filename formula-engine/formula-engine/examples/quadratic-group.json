  "formulas": [
    {
      "name": "calculate-delta",
      "expression": "delta = b ^ 2 - four * a * c"
    },
    {
      "name": "calculate-x1",
      "expression": "x1 = (-b + sqrt(delta)) / (two * a)"
    },
    {
      "name": "calculate-x2",
      "expression": "x2 = (-b - sqrt(delta)) / (two * a)"
    }
